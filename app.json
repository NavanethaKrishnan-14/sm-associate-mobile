{
  "expo": {
    "name": "SM Associate",
    "slug": "sm-associate",
    "version": "1.2.3",
    "orientation": "default",
    "platforms": [
      "android",
      "ios"
    ],
    "userInterfaceStyle": "light",
    "icon": "./assets/sm-associate-exact-app-icon.png",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "icon": "./assets/sm-associate-exact-app-icon.png"
    },
    "android": {
      "package": "com.smassociate.management",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/sm-associate-exact-app-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "newArchEnabled": true
  }
}
